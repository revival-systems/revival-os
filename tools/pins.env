# Pinned toolchain versions for Revival OS: the single source of truth.
# Read by tools/*.sh (sourced as shell) and by the Makefile (included as make
# variables), so keep every line in plain NAME=value form with no quotes.
# Changing a pin is a reviewed pull request that records why.

# Goose compiler: the same release Revival Server pins
# (revival-server scripts/install-goose-linux.sh at fc6848ed). Do not change
# it here alone.
GOOSE_VERSION=v2026.3
GOOSE_RUNTIME=4d3da949e563
GOOSE_ASSET=goose-v2026.3-linux-x64.tar.gz
GOOSE_ASSET_SHA256=06ac30284338269d3996d457412bf4f2b47c1f9a5601de65b6317187fe78d5c9
GOOSE_BINARY_SHA256=b56c1cf28f020a89ae164ee53c086d8ffff04f285331115ce448e1d4244eca24

# Arm GNU Toolchain (bare-metal arm-none-eabi, x86_64 Linux host), from
# developer.arm.com. SHA-256 as published by Arm in the release's .sha256asc.
ARM_TOOLCHAIN_VERSION=15.2.rel1
ARM_TOOLCHAIN_NAME=arm-gnu-toolchain-15.2.rel1-x86_64-arm-none-eabi
ARM_TOOLCHAIN_SHA256=597893282ac8c6ab1a4073977f2362990184599643b4c5ee34870a8215783a16
